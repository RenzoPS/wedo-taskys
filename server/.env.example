# Copiar a .env y completar. El .env real está ignorado.

PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wedo-taskys

# Origen del frontend. Lo usa CORS y tiene que coincidir exacto,
# incluido el puerto, o el navegador bloquea las llamadas.
CLIENT_URL=http://localhost:5173

# Secretos de firma. Distintos entre sí: si se filtra el de acceso,
# el de refresco sigue sirviendo y no se pueden emitir sesiones nuevas.
ACCESS_TOKEN_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
REFRESH_TOKEN_SECRET=cambiar-por-otra-cadena-larga-y-distinta
